{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchstone.invalid/schemas/deployment-manifest.json",
  "title": "Touchstone deployment manifest",
  "description": "Strict deployment manifests for the legacy Registry and RegistryV2.",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "reporting_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "public_key", "state"],
      "properties": {
        "kid": {
          "type": "string",
          "minLength": 1
        },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "enum": ["active", "superseded", "revoked"]
        },
        "not_after": {
          "type": "string"
        }
      }
    },
    "common": {
      "type": "object",
      "required": [
        "manifest_version",
        "network",
        "chain_id",
        "rpc_url",
        "registry_address",
        "registry_runtime_bytecode_sha256",
        "publisher_address",
        "publisher_identity_address",
        "deployer_address",
        "operations_address",
        "confirmations",
    "reporting_keys",
    "deployment_state",
        "deployment_block"
      ],
      "properties": {
        "manifest_version": {
          "type": "integer"
        },
        "network": {
          "type": "string",
          "enum": ["hardhat-local", "xlayer-testnet", "xlayer-mainnet"]
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "rpc_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "registry_address": {
          "$ref": "#/$defs/address"
        },
        "registry_runtime_bytecode_sha256": {
          "$ref": "#/$defs/digest"
        },
        "publisher_address": {
          "$ref": "#/$defs/address"
        },
        "publisher_identity_address": {
          "$ref": "#/$defs/address"
        },
        "deployer_address": {
          "$ref": "#/$defs/address"
        },
        "operations_address": {
          "$ref": "#/$defs/address"
        },
        "confirmations": {
          "type": "integer",
          "minimum": 1
        },
        "deployment_state": {
          "type": "string",
          "enum": ["active", "superseded"]
        },
        "max_fee_wei": {
          "type": "integer",
          "minimum": 1
        },
        "deployment_block": {
          "type": "integer",
          "minimum": 1
        },
        "reporting_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reporting_key"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "network": {
                "not": {
                  "const": "hardhat-local"
                }
              }
            }
          },
          "then": {
            "required": ["max_fee_wei"]
          }
        }
      ]
    },
    "v1": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "properties": {
            "manifest_version": {
              "const": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "v2": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "registry_version",
            "legacy_registry_address",
            "legacy_registry_runtime_bytecode_sha256",
            "owner_address",
            "relayer_address",
            "deployment_transaction",
            "authorization_transaction"
          ],
          "properties": {
            "manifest_version": {
              "const": 2
            },
            "registry_version": {
              "const": 2
            },
            "legacy_registry_address": {
              "$ref": "#/$defs/address"
            },
            "legacy_registry_runtime_bytecode_sha256": {
              "$ref": "#/$defs/digest"
            },
            "owner_address": {
              "$ref": "#/$defs/address"
            },
            "relayer_address": {
              "$ref": "#/$defs/address"
            },
            "deployment_transaction": {
              "$ref": "#/$defs/transaction_hash"
            },
            "authorization_transaction": {
              "$ref": "#/$defs/transaction_hash"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transaction_hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  }
}

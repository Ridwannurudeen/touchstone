# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/
dist/
build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets and local configuration
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist

# Runtime evidence and generated data
data/*
runtime/

# Except the compilation artifacts, which are release inputs rather than runtime state.
# Each approved control pins one of these by digest, and an offline verifier resolves the
# binding against it — so a control set is only checkable if these travel with the source.
!data/compilations/

# Policy manifests are signed release inputs, not runtime observations. They must ship so
# clean clones and public CI evaluate the same predeclared policies as local workspaces.
!data/policies/
!data/policies/*.json

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Scratch output from local tooling (PDF extraction and similar). Never shipped: it can
# hold third-party material — an audit extraction here included the auditor's contact
# photos — and a pre-publication `git add -A` must not be able to sweep any of it in.
tmp/
.playwright-mcp/

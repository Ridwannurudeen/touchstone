[Unit]
Description=Touchstone FOBXX source observer (%i)
Documentation=file:/opt/touchstone/docs/DEPLOY-SERVICE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=touchstone-observer
Group=touchstone-data
UMask=0002
WorkingDirectory=/opt/touchstone
# Public operator identity, not key material. SEC fair-access policy requires a named
# requester and monitored contact address in the User-Agent.
EnvironmentFile=/etc/touchstone/%i-fobxx-source.env
ExecStart=/opt/touchstone/.venv/bin/python /opt/touchstone/scripts/run_observer.py \
    --workspace /var/lib/touchstone/%i/fobxx \
    --asset-key eip155:1:0x3ddc84940ab509c11b20b76b466933f40b750dc9 \
    --source-user-agent=${TOUCHSTONE_SEC_USER_AGENT} \
    --interval-seconds 900

Restart=always
RestartSec=120
TimeoutStopSec=30
ReadWritePaths=/var/lib/touchstone/%i
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=512M
CPUQuota=25%
TasksMax=64

[Install]
WantedBy=multi-user.target

[Unit]
Description=Touchstone FOBXX daily epoch service (%i)
Documentation=file:/opt/touchstone/docs/DEPLOY-SERVICE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=touchstone
Group=touchstone-data
UMask=0002
WorkingDirectory=/opt/touchstone
EnvironmentFile=/etc/touchstone/%i.env
# Public operator identity required by SEC fair-access policy; contains no key material.
EnvironmentFile=/etc/touchstone/%i-fobxx-source.env
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/touchstone/.venv/bin/python /opt/touchstone/scripts/run_service.py \
    --manifest /opt/touchstone/deployments/%i.json \
    --workspace /var/lib/touchstone/%i/fobxx \
    --asset-key eip155:1:0x3ddc84940ab509c11b20b76b466933f40b750dc9 \
    --source-user-agent=${TOUCHSTONE_SEC_USER_AGENT}

Restart=always
RestartSec=300
TimeoutStopSec=120
ReadWritePaths=/var/lib/touchstone/%i
StateDirectory=touchstone

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

MemoryMax=1G
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target

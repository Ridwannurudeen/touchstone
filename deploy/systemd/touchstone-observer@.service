[Unit]
# The watcher. Instance is the network name, e.g. touchstone-observer@xlayer-mainnet.
#
# This unit deliberately has NO EnvironmentFile. The observer is given no key material and
# contains no signing or publishing code. If a future change makes it need a secret, that
# change is wrong, and this missing line is where it should be noticed.
#
# It also runs as its OWN Unix identity, `touchstone-observer`, which is not the identity the
# publisher runs as. That is what makes "the observer cannot reach the publisher's key" a
# statement about the operating system rather than about this program's imports: systemd puts
# the publisher's secrets in the publisher process's environment, and same-UID code can read
# another same-UID process's environment on a host with ordinary /proc permissions. Two
# identities remove that path. The two share only the group that owns the workspace.
Description=Touchstone source observer (%i)
Documentation=file:/opt/touchstone/docs/DEPLOY-SERVICE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=touchstone-observer
Group=touchstone-data
# Group-writable, because the
# publisher writes the same evidence store under a different user.
UMask=0002
WorkingDirectory=/opt/touchstone
ExecStart=/opt/touchstone/.venv/bin/python /opt/touchstone/scripts/run_observer.py \
    --workspace /var/lib/touchstone/%i/ustb \
    --asset-key eip155:1:0x43415eb6ff9db7e26a15b704e7a3edce97d31c4e \
    --interval-seconds 900

# The issuer is a third party. A crash loop that reconnected instantly would become a burst
# against them, so a restart waits longer than the poll interval it is restarting into.
Restart=always
RestartSec=120
TimeoutStopSec=30

# The workspace is the only thing it may write. Its evidence is the one artifact in this
# project that cannot be recreated, and everything else on a shared host is none of its
# business.
ReadWritePaths=/var/lib/touchstone/%i
StateDirectory=touchstone

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The box carries roughly 37 other live sites and runs hot. A watcher that parses a 226 KB
# feed every fifteen minutes needs very little, and a bound is cheaper than an argument
# about whose process caused an outage.
MemoryMax=512M
CPUQuota=25%
TasksMax=64

[Install]
WantedBy=multi-user.target

{
  "name": "touchstone-sdk",
  "version": "0.1.0",
  "description": "Read Touchstone RWA policy gates and Registry v2 reports on X Layer, and execute guarded actions only when a gate permits",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ridwannurudeen/touchstone.git",
    "directory": "sdk"
  },
  "homepage": "https://touchstone.gudman.xyz/developers",
  "bugs": {
    "url": "https://github.com/Ridwannurudeen/touchstone/issues"
  },
  "keywords": [
    "touchstone",
    "rwa",
    "x-layer",
    "xlayer",
    "policy-gate",
    "registry",
    "ethers",
    "erc-8021"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "solidity",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:example": "tsc --ignoreConfig --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck examples/check-and-act.ts",
    "test": "npm run build && npm run check:example && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
